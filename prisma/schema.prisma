// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserRole {
  admin
  doctor
  receptionist
  pharmacist
  lab_technician
}

enum AppointmentStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum PrescriptionStatus {
  pending
  dispensed
  cancelled
}

enum LabTestStatus {
  requested
  in_progress
  completed
  cancelled
}

model Staff {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String   // We'll hash this
  fullName    String   @map("full_name")
  role        UserRole
  department  String?
  phone       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdAppointments Appointment[] @relation("CreatedBy")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")
  medicalRecords      MedicalRecord[]
  prescriptions       Prescription[]
  labTestsOrdered     LabTest[]     @relation("OrderedBy")
  labTestsProcessed   LabTest[]     @relation("ProcessedBy")
  dispensedPrescriptions Prescription[] @relation("DispensedBy")
  billingRecords      Billing[]

  @@map("staff")
}

model Patient {
  id               String   @id @default(cuid())
  patientId        String   @unique @map("patient_id")
  fullName         String   @map("full_name")
  dateOfBirth      DateTime? @map("date_of_birth")
  gender           String?
  phone            String?
  email            String?
  address          String?
  emergencyContact String?  @map("emergency_contact")
  emergencyPhone   String?  @map("emergency_phone")
  bloodGroup       String?  @map("blood_group")
  allergies        String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  labTests        LabTest[]
  billingRecords  Billing[]

  @@map("patients")
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String            @map("patient_id")
  doctorId        String?           @map("doctor_id")
  appointmentDate DateTime          @map("appointment_date")
  appointmentTime String            @map("appointment_time")
  department      String?
  reason          String?
  status          AppointmentStatus @default(scheduled)
  notes           String?
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Staff?   @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)
  createdBy   Staff?   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  medicalRecords MedicalRecord[]
  billing     Billing[]

  @@map("appointments")
}

model MedicalRecord {
  id            String   @id @default(cuid())
  patientId     String   @map("patient_id")
  doctorId      String?  @map("doctor_id")
  appointmentId String?  @map("appointment_id")
  diagnosis     String?
  symptoms      String?
  treatmentPlan String?  @map("treatment_plan")
  notes         String?
  visitDate     DateTime @default(now()) @map("visit_date")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Staff?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@map("medical_records")
}

model Prescription {
  id             String             @id @default(cuid())
  patientId      String             @map("patient_id")
  doctorId       String?            @map("doctor_id")
  medicationName String             @map("medication_name")
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  status         PrescriptionStatus @default(pending)
  prescribedDate DateTime           @default(now()) @map("prescribed_date")
  dispensedById  String?            @map("dispensed_by_id")
  dispensedDate  DateTime?          @map("dispensed_date")
  createdAt      DateTime           @default(now()) @map("created_at")

  // Relations
  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Staff?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  dispensedBy Staff?  @relation("DispensedBy", fields: [dispensedById], references: [id], onDelete: SetNull)

  @@map("prescriptions")
}

model LabTest {
  id            String        @id @default(cuid())
  patientId     String        @map("patient_id")
  doctorId      String?       @map("doctor_id")
  testName      String        @map("test_name")
  testType      String?       @map("test_type")
  status        LabTestStatus @default(requested)
  requestedDate DateTime      @default(now()) @map("requested_date")
  completedDate DateTime?     @map("completed_date")
  results       String?
  reportFileUrl String?       @map("report_file_url")
  technicianId  String?       @map("technician_id")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor     Staff?  @relation("OrderedBy", fields: [doctorId], references: [id], onDelete: SetNull)
  technician Staff?  @relation("ProcessedBy", fields: [technicianId], references: [id], onDelete: SetNull)

  @@map("lab_tests")
}

model Inventory {
  id           String    @id @default(cuid())
  medicationName String  @map("medication_name")
  batchNumber  String?   @map("batch_number")
  quantity     Int       @default(0)
  unitPrice    Float?    @map("unit_price")
  expiryDate   DateTime? @map("expiry_date")
  supplier     String?
  minimumStock Int       @default(10) @map("minimum_stock")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("inventory")
}

model Billing {
  id            String   @id @default(cuid())
  patientId     String   @map("patient_id")
  appointmentId String?  @map("appointment_id")
  totalAmount   Float    @map("total_amount")
  paidAmount    Float    @default(0) @map("paid_amount")
  paymentStatus String   @default("pending") @map("payment_status")
  paymentMethod String?  @map("payment_method")
  invoiceNumber String?  @unique @map("invoice_number")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   Staff?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("billing")
}
